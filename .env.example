# ====== Copie ce fichier en ".env" puis remplis-le (voir README.md) ======

# Tout se règle plus simplement dans l'appli (bouton Réglages). Ce fichier est optionnel.

# --- Quelle IA : auto (Claude, sinon gratuite) | claude | groq ---
AI_PROVIDER=auto

# --- IA gratuite (Groq) : clé gratuite sur console.groq.com ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- L'IA Claude (payante) ---
# Clé à créer sur https://platform.claude.com (section API Keys)
ANTHROPIC_API_KEY=
# claude-haiku-5-5 = très pas cher (défaut) | claude-sonnet-5-5 = plus malin | claude-opus-5-5 = le plus fort
CLAUDE_MODEL=claude-haiku-5-5
# Réflexion : low (rapide, défaut) | medium | high
CLAUDE_EFFORT=low
# Recherche web par l'IA (environ 1 centime par recherche) : true / false
ENABLE_WEB_SEARCH=true

# --- Personnalisation ---
ASSISTANT_NAME=Jarvis
USER_NAME=
CITY=Paris
TIMEZONE=Europe/Paris
PORT=3000

# --- Google : Agenda, Gmail, Tâches (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify (optionnel) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
